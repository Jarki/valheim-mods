<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>NearbyStore</AssemblyName>
    <Version>1.1.2</Version>
    <GameDir Condition="'$(GameDir)' == ''">$(HOME)/.local/share/Steam/steamapps/common/Valheim</GameDir>
    <ReferenceProfile Condition="'$(ReferenceProfile)' == ''">$(HOME)/.config/r2modmanPlus-local/Valheim/profiles/Valheim2</ReferenceProfile>
    <ManagedDir>$(GameDir)/valheim_Data/Managed</ManagedDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(ManagedDir)/assembly_valheim.dll;$(ManagedDir)/assembly_utils.dll;$(ManagedDir)/UnityEngine*.dll;$(ManagedDir)/SoftReferenceableAssets.dll;$(ManagedDir)/Splatform.dll;$(ManagedDir)/Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="$(ManagedDir)/assembly_guiutils.dll" Private="false" />
    <Reference Include="$(ReferenceProfile)/BepInEx/core/BepInEx.dll;$(ReferenceProfile)/BepInEx/core/0Harmony.dll" Private="false" />
  </ItemGroup>
  <Target Name="CheckLocalReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ManagedDir)/assembly_valheim.dll')" Text="Set GameDir to your owned native Valheim install." />
    <Error Condition="!Exists('$(ReferenceProfile)/BepInEx/core/0Harmony.dll')" Text="Set ReferenceProfile to an existing BepInEx profile. References are read-only and not bundled." />
  </Target>
</Project>
