<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>10</LangVersion>
    <AssemblyName>ServerMetrics</AssemblyName>
    <Version>1.4.0</Version>
    <GameDir Condition="'$(GameDir)' == ''">$(HOME)/.local/share/Steam/steamapps/common/Valheim</GameDir>
    <ReferenceProfile Condition="'$(ReferenceProfile)' == ''">$(HOME)/.config/r2modmanPlus-local/Valheim/profiles/Valheim2</ReferenceProfile>
    <ManagedDir Condition="'$(ManagedDir)' == ''">$(GameDir)/valheim_Data/Managed</ManagedDir>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(ManagedDir)/assembly_valheim.dll;$(ManagedDir)/assembly_utils.dll;$(ManagedDir)/UnityEngine.dll;$(ManagedDir)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(ReferenceProfile)/BepInEx/core/BepInEx.dll;$(ReferenceProfile)/BepInEx/core/0Harmony.dll" Private="false" />
  </ItemGroup>
  <Target Name="CheckLocalReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ManagedDir)/assembly_valheim.dll')" Text="Set ManagedDir to your Valheim client or dedicated server Managed directory. Assemblies are read-only references, not bundled." />
    <Error Condition="!Exists('$(ReferenceProfile)/BepInEx/core/BepInEx.dll') Or !Exists('$(ReferenceProfile)/BepInEx/core/0Harmony.dll')" Text="Set ReferenceProfile to an existing BepInEx 5 profile. References are read-only and not bundled." />
  </Target>
</Project>
