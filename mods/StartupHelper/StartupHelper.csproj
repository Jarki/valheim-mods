<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>StartupHelper</AssemblyName>
    <Version>1.0.0</Version>
    <GameDir Condition="'$(GameDir)' == ''">$(HOME)/.local/share/Steam/steamapps/common/Valheim</GameDir>
    <ReferenceProfile Condition="'$(ReferenceProfile)' == ''">$(MSBuildProjectDirectory)/../../.dev/reference-profile</ReferenceProfile>
    <ManagedDir>$(GameDir)/valheim_Data/Managed</ManagedDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(ManagedDir)/assembly_valheim.dll;$(ManagedDir)/assembly_utils.dll;$(ManagedDir)/assembly_guiutils.dll;$(ManagedDir)/UnityEngine*.dll;$(ManagedDir)/Unity.TextMeshPro.dll;$(ManagedDir)/gui_framework.dll" Private="false" />
    <Reference Include="$(ReferenceProfile)/BepInEx/core/BepInEx.dll;$(ReferenceProfile)/BepInEx/core/0Harmony.dll" Private="false" />
  </ItemGroup>
  <Target Name="CheckLocalReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ManagedDir)/assembly_valheim.dll')" Text="Set GameDir to your owned native Valheim install." />
    <Error Condition="!Exists('$(ReferenceProfile)/BepInEx/core/BepInEx.dll') Or !Exists('$(ReferenceProfile)/BepInEx/core/0Harmony.dll')" Text="Set ReferenceProfile to a BepInEx 5 profile. References are read-only and not bundled." />
  </Target>
</Project>
