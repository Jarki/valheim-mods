<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MobThreat</AssemblyName>
    <Version>1.0.1</Version>
    <GameDir Condition="'$(GameDir)' == ''">$(HOME)/.local/share/Steam/steamapps/common/Valheim</GameDir>
    <ReferenceProfile Condition="'$(ReferenceProfile)' == ''">$(HOME)/.config/r2modmanPlus-local/Valheim/profiles/Valheim2</ReferenceProfile>
    <ManagedDir>$(GameDir)/valheim_Data/Managed</ManagedDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(ManagedDir)/assembly_valheim.dll;$(ManagedDir)/assembly_utils.dll;$(ManagedDir)/UnityEngine*.dll;$(ManagedDir)/SoftReferenceableAssets.dll;$(ManagedDir)/Splatform.dll" Private="false" />
    <Reference Include="$(ReferenceProfile)/BepInEx/core/BepInEx.dll" Private="false" />
    <Reference Include="$(ManagedDir)/Unity.TextMeshPro.dll" Private="false" />
  </ItemGroup>
  <Target Name="CheckLocalReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ManagedDir)/assembly_valheim.dll')" Text="Set GameDir to your owned native Valheim install." />
    <Error Condition="!Exists('$(ReferenceProfile)/BepInEx/core/BepInEx.dll')" Text="Set ReferenceProfile to a BepInEx profile. References are read-only and not bundled." />
  </Target>
</Project>
