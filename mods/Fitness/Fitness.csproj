<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Fitness</AssemblyName>
    <Version>0.1.1</Version>
    <GameDir Condition="'$(GameDir)' == ''">$(HOME)/.local/share/Steam/steamapps/common/Valheim</GameDir>
    <ReferenceProfile Condition="'$(ReferenceProfile)' == ''">$(MSBuildProjectDirectory)/../../.dev/release/reference-profile</ReferenceProfile>
    <ManagedDir Condition="'$(ManagedDir)' == ''">$(GameDir)/valheim_Data/Managed</ManagedDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(ManagedDir)/assembly_valheim.dll;$(ManagedDir)/assembly_utils.dll;$(ManagedDir)/assembly_guiutils.dll;$(ManagedDir)/SoftReferenceableAssets.dll;$(ManagedDir)/UnityEngine*.dll;$(ManagedDir)/Unity.TextMeshPro.dll;$(ManagedDir)/Splatform.dll;$(ManagedDir)/gui_framework.dll" Private="false" />
    <Reference Include="$(ReferenceProfile)/BepInEx/core/BepInEx.dll;$(ReferenceProfile)/BepInEx/core/0Harmony.dll;$(ReferenceProfile)/BepInEx/plugins/ValheimModding-Jotunn/Jotunn.dll" Private="false" />
  </ItemGroup>
  <Target Name="CheckLocalReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ManagedDir)/assembly_valheim.dll')" Text="Set GameDir to your owned native Valheim installation." />
    <Error Condition="!Exists('$(ReferenceProfile)/BepInEx/plugins/ValheimModding-Jotunn/Jotunn.dll')" Text="Set ReferenceProfile to read-only BepInEx/Jotunn references." />
  </Target>
</Project>
